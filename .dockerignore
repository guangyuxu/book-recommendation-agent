# --- Dependencies / virtualenvs (must never enter the image; reinstalled inside) ---
.venv
venv
env
node_modules
vendor

# --- Secrets / env files: injected at runtime via env_file / k8s Secret, never baked into a layer ---
.env
.env.*
*.local

# --- git / CI / Docker itself ---
.git
.gitignore
.dockerignore
.github
docker-compose.yml
Dockerfile

# --- Local agent/editor state (never needed at runtime) ---
.claude

# --- Build artifacts / caches ---
dist
build
*.egg-info
.cache
.ruff_cache
.mypy_cache
.pytest_cache
__pycache__
*.py[cod]

# --- LangGraph local dev artifacts ---
.langgraph_api

# --- Docs / static assets (not needed at runtime) ---
README.md
LICENSE
static

# --- k8s manifests (deploy-time, not runtime) ---
k8s

# --- Scripts (dev/migration tools, not imported by the app) ---
scripts

# --- IDE / OS ---
.vscode
.idea
.DS_Store
Thumbs.db

# --- Tests / evals (dev-only; the runtime graph never imports these) ---
tests
evals
eval_regression
*.coverage
.coverage
coverage

# --- Logs / temp files ---
*.log
*.tmp
*.swp
