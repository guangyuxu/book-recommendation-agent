# --- Dependencies / virtualenvs (must never enter the image; reinstalled inside) ---
.venv
venv
env
node_modules
vendor

# --- Secrets / env files: injected at runtime via env_file / k8s Secret, never baked into a layer ---
.env
.env.*
*.local

# --- git / Docker itself ---
.git
.gitignore
.dockerignore
docker-compose.yml
Dockerfile

# --- Build artifacts / caches ---
dist
build
*.egg-info
.cache
.ruff_cache
.mypy_cache
.pytest_cache
__pycache__
*.py[cod]

# --- LangGraph local dev artifacts ---
.langgraph_api

# --- IDE / OS ---
.vscode
.idea
.DS_Store

# --- Tests ---
tests
*.coverage
coverage

# --- Logs / temp files ---
*.log
*.tmp
*.swp
